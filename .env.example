# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
CLIENT_SECRET=your_oauth2_client_secret_here

# OAuth2 Redirect URI (your server must handle this)
OAUTH_REDIRECT_URI=https://yourdomain.com/oauth/callback

# Database (SQLite file path or PostgreSQL URL)
DATABASE_URL=./data/bot.db

# Bot Configuration
BOT_OWNER_ID=your_discord_user_id_here
MASTER_SERVER_ID=your_master_discord_server_id_here
OWO_BOT_ID=408785106942164992

# Subscription Settings
SUBSCRIPTION_AMOUNT=25000000
SUBSCRIPTION_DAYS=30

# Global API Key for all Minecraft slots
GLOBAL_API_KEY=your_secure_api_key_here

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# Health check HTTP server port (for UptimeRobot / uptime monitors)
HEALTH_PORT=3000
